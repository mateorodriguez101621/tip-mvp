# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings → API). Las dos son públicas por diseño; los datos los protege RLS.
# Sin estas variables, la app corre en "modo local" con los datos guardados en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
